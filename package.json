{
  "name": "pagecraft",
  "version": "1.4.0",
  "description": "Create custom CSS themes for the websites you visit, by hand or with AI.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv3",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv3",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs"
  },
  "devDependencies": {
    "@types/css-tree": "^3.2.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "css-tree": "^3.2.1"
  }
}
